# Copia este archivo como .env.local y completa lo que tengas. Lo vacío se oculta solo.
NEXT_PUBLIC_SITE_URL=https://jeancharlesofficial.com

# Agenda (Calendly), contacto
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Analítica (solo carga si el visitante acepta cookies)
NEXT_PUBLIC_GA_ID=

# Newsletter: URL "action" de Mailchimp / ConvertKit / Beehiiv
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Área de miembros (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
